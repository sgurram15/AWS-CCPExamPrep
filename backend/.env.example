# Copy to backend/.env and adjust as needed. All values have safe local defaults.

# --- Database (SQLite by default; point at Postgres to scale later) ---
# DATABASE_URL=sqlite:///./ccp_prep.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ccp_prep

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (the Next.js dev server) ---
# CORS_ORIGINS=["http://localhost:3000"]

# --- Ingestion ---
# Randomise option order so a dataset with the answer always in slot A isn't gameable.
SHUFFLE_OPTIONS_ON_INGEST=true

# --- Optional generative AI tutor (OFF = zero cost) ---
AI_TUTOR_ENABLED=false
AI_PROVIDER=none           # none | anthropic | openai
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
